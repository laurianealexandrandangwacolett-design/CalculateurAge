<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'âge">

    <ContentPage.BindingContext>
        <vm:CalculateurViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Nom" FontSize="16"/>
        <Entry Text="{Binding Nom}"
               Placeholder="Votre nom"
               FontSize="16"/>

        <Label Text="Date de naissance" FontSize="16"/>
        <DatePicker Date="{Binding DateNaissance}"
                    FontSize="16"/>

        <Button Text="Calculer"
                Command="{Binding CalculerCommand}"
                FontSize="18"
                BackgroundColor="#512BD4"
                TextColor="White"/>

    </VerticalStackLayout>

</ContentPage>