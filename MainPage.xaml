<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'âge">

    <ContentPage.BindingContext>
        <vm:CalculateurViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Nom" FontSize="16"/>
        <Entry Text="{Binding Nom}"
               Placeholder="Votre nom"
               FontSize="16"/>

        <Label Text="Date de naissance" FontSize="16"/>
        <DatePicker Date="{Binding DateNaissance}"
                    FontSize="16"/>

        <!-- Bouton Calculer -->
        <Button Text="Calculer"
                Command="{Binding CalculerCommand}"
                FontSize="18"
                BackgroundColor="#512BD4"
                TextColor="White"/>

        <!-- Bouton Effacer -->
        <Button Text="Effacer"
                Command="{Binding EffacerCommand}"
                FontSize="18"
                BackgroundColor="#E74C3C"
                TextColor="White"/>

        <!-- Message d'erreur date future -->
        <Label Text="{Binding MessageErreur}"
               TextColor="Red"
               FontSize="16"
               FontAttributes="Bold"/>

        <!-- Résultat -->
        <Label Text="{Binding Resultat}"
               FontSize="20"
               FontAttributes="Bold"
               IsVisible="{Binding ResultatVisible}"/>

        <!-- Majeur / Mineur -->
        <Label Text="{Binding Message}"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               IsVisible="{Binding ResultatVisible}"/>

    </VerticalStackLayout>

</ContentPage>