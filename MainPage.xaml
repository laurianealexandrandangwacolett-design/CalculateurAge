<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'âge">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Nom" FontSize="16"/>
        <Entry x:Name="entryNom"
               Placeholder="Votre nom"
               FontSize="16"/>

        <Label Text="Date de naissance" FontSize="16"/>
        <DatePicker x:Name="pickerDate"
                    FontSize="16"/>

        <Button Text="Calculer"
                Clicked="OnCalculerClicked"
                FontSize="18"
                BackgroundColor="#512BD4"
                TextColor="White"/>

        <Label x:Name="lblResultat"
               FontSize="20"
               FontAttributes="Bold"
               IsVisible="False"/>

    </VerticalStackLayout>

</ContentPage>